<mujoco model="ugv">
  <compiler angle="degree" coordinate="local" meshdir="none"/>
  <option timestep="0.02" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>
  <default>
    <geom type="cylinder" condim="3" friction="1.0 0.005 0.0001"/>
    <joint type="hinge" damping="0.1" armature="0.005"/>
  </default>
  <worldbody>
    <!-- 全局光源: 增强环境光保证 GUI/渲染不黑 (黑屏主因=环境光不足) -->
    <light pos="0 0 12" dir="0 0 -1" diffuse="0.95 0.95 0.95" ambient="0.75 0.75 0.75" castshadow="true"/>
    <light pos="-12 0 6" dir="1 0 -0.3" diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35"/>
    <light pos="12 0 6" dir="-1 0 -0.3" diffuse="0.5 0.5 0.5" ambient="0.35 0.35 0.35"/>
    <light pos="0 12 4" dir="0 -1 -0.3" diffuse="0.45 0.45 0.45" ambient="0.3 0.3 0.3"/>
    <!-- 固定俯视相机 (GUI/渲染用: 从上方 45° 看全场景, 视角明确不黑) -->
    <camera name="top_view" pos="0 0 13" quat="0.924 0.383 0 0" mode="fixed"/>
    <!-- 地面 -->
    <geom name="ground" type="plane" size="10 10 0.1" rgba="0.3 0.5 0.3 1" friction="1.0"/>
    <!-- 目标标记: 金色球, reset 时动态更新位置 (纯可视化, 不参与碰撞/激光) -->
    <geom name="goal_marker" type="sphere" size="0.18" pos="0 0 0.4" rgba="1.0 0.85 0.0 1" contype="0" conaffinity="0"/>
    <!-- ===== 边界墙 (实体, 与 gazebo SquareWorld2 对齐 ±5.425m; 四角重叠无缝隙) ===== -->
    <geom name="wall_n" type="box" size="5.5 0.15 0.3" pos="0 5.425 0.3" rgba="0.6 0.6 0.6 1" friction="0.9"/>
    <geom name="wall_s" type="box" size="5.5 0.15 0.3" pos="0 -5.425 0.3" rgba="0.6 0.6 0.6 1" friction="0.9"/>
    <geom name="wall_e" type="box" size="0.15 5.5 0.3" pos="5.425 0 0.3" rgba="0.6 0.6 0.6 1" friction="0.9"/>
    <geom name="wall_w" type="box" size="0.15 5.5 0.3" pos="-5.425 0 0.3" rgba="0.6 0.6 0.6 1" friction="0.9"/>

    <!-- ===== 障碍物 (每个包一层静态 body: 位置/旋转用 body_pos/body_quat 动态改 (mujoco 3.11 中
         geom_quat 运行时赋值不生效, body_quat 生效); geom 尺寸/颜色/contype 动态改) ===== -->
    <body name="obsb_0" pos="30 30 0.3"><geom name="obs_0" type="box" size="0.2 0.2 0.3" rgba="0.9 0.6 0.2 1" friction="0.8"/></body>
    <body name="obsb_1" pos="30 30 0.3"><geom name="obs_1" type="box" size="0.25 0.15 0.3" rgba="0.9 0.6 0.2 1" friction="0.8"/></body>
    <body name="obsb_2" pos="30 30 0.3"><geom name="obs_2" type="box" size="0.15 0.25 0.3" rgba="0.9 0.6 0.2 1" friction="0.8"/></body>
