    <body name="obsb_13" pos="30 30 0.3"><geom name="obs_13" type="box" size="0.35 0.08 0.3" rgba="0.7 0.7 0.7 1" friction="0.8"/></body>
    <body name="obsb_14" pos="30 30 0.3"><geom name="obs_14" type="box" size="0.25 0.25 0.3" rgba="0.8 0.5 0.3 1" friction="0.8"/></body>
    <body name="obsb_15" pos="30 30 0.3"><geom name="obs_15" type="box" size="0.22 0.15 0.3" rgba="0.8 0.5 0.3 1" friction="0.8"/></body>
    <body name="obsb_16" pos="30 30 0.3"><geom name="obs_16" type="box" size="0.02 0.02 0.5" rgba="0.25 0.25 0.25 1" friction="0.8"/></body>
    <body name="obsb_17" pos="30 30 0.3"><geom name="obs_17" type="box" size="0.02 0.02 0.5" rgba="0.25 0.25 0.25 1" friction="0.8"/></body>
    <body name="obsb_18" pos="30 30 1.0"><geom name="obs_18" type="box" size="0.75 0.4 0.03" rgba="0.45 0.4 0.3 1" friction="0.8" contype="0" conaffinity="0"/></body>

    <!-- ===== UGV 底盘 (URDF: 半径0.10 高0.12, 装高0.076) ===== -->
    <body name="chassis" pos="0 0 0.076">
      <freejoint name="root"/>
      <geom name="base_link" type="cylinder" size="0.10 0.06" mass="1.8" rgba="0.1 0.1 1.0 0.8" friction="0.8"/>
      <!-- 激光雷达 (装高 +0.075) -->
      <geom name="laser" type="cylinder" size="0.02 0.01" pos="0 0 0.075" mass="0.02" rgba="0.0 0.0 0.0 0.5" friction="0.5"/>
      <!-- 左轮 (轮径6.5cm, 轮距~16cm) -->
      <body name="wheel_l" pos="0 -0.08 0">
        <joint name="wheel_l_joint" axis="0 1 0"/>
        <geom name="wheel_l_geom" type="cylinder" size="0.0325 0.02" mass="0.08" rgba="0.1 0.1 0.1 1" friction="1.2"/>
      </body>
      <!-- 右轮 -->
      <body name="wheel_r" pos="0 0.08 0">
        <joint name="wheel_r_joint" axis="0 1 0"/>
        <geom name="wheel_r_geom" type="cylinder" size="0.0325 0.02" mass="0.08" rgba="0.1 0.1 0.1 1" friction="1.2"/>
      </body>
      <!-- 鱼眼摄像头 (lidar 前方 0.12m, 同高 0.075 世界高=0.151, 对齐真车 OV3660@ESP32S3) -->
      <camera name="fisheye" pos="0.12 0 0.075" mode="fixed" zaxis="1 0 0"/>
      <!-- 后支撑轮 -->
      <body name="caster" pos="-0.07 0 -0.052">
        <geom name="caster_geom" type="sphere" size="0.015" mass="0.01" rgba="0.5 0.5 0.5 1" friction="0.5"/>
      </body>
    </body>

