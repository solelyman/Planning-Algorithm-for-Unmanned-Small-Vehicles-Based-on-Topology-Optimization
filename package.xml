<?xml version="1.0"?>
<package format="3">
  <name>multi_usv_planner</name>
  <version>0.1.0</version>
  <description>Contouring MPC planner for the Fishbot two-wheel differential robot, with soft ellipsoid (Test A) and hard linearized (Test B) obstacle constraints.</description>
  <maintainer email="solelyman@example.com">solelyman</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
